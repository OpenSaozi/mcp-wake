{
  "name": "mcp-wake",
  "version": "0.4.0",
  "description": "Claude Code 对 MCP 协议的支持不够完整：通过 MCP 跑异步长任务（比如指挥 Codex 干活）时，无法订阅服务端的事件，也拿不到任务的最新进展。本项目基于 MCP 标准协议实现了通知订阅，替客户端补足缺口，让 Claude Code 或任意其它客户端都能订阅服务端消息。支持远程 HTTP 与本地 stdio 两种传输。",
  "type": "module",
  "bin": {
    "mcp-wake": "bin/mcp-wake.mjs"
  },
  "license": "MIT",
  "author": "OpenSaozi",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "notification",
    "subscribe",
    "wake",
    "cli"
  ],
  "files": [
    "bin",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSaozi/mcp-wake.git"
  },
  "bugs": {
    "url": "https://github.com/OpenSaozi/mcp-wake/issues"
  },
  "homepage": "https://github.com/OpenSaozi/mcp-wake#readme"
}
